# Copy to .env and adjust. Values here are the Mininet defaults.

# --- Mininet addressing ---
SERVER_IP=10.0.0.1
TRANSFER_PORT=9000

# --- application ---
SERVER_HOST_BIND=0.0.0.0
FILE_SERVER_HOST=10.0.0.1
FILE_SERVER_PORT=9000

# --- SDN controller ---
CONTROLLER_OFP_PORT=6653
CONTROLLER_REST=http://127.0.0.1:8080
# seconds; 0 = no hard timeout on grant flows
GRANT_TIMEOUT=0
